<%- include('../partials/header') %>

<div style="background: white; padding: 20px; border-radius: 4px;">
    <h2><%= task.title %></h2>
    
    <div class="form-group">
        <label>Проект:</label>
        <p><strong><%= task.project_name %></strong></p>
    </div>
    
    <div class="form-group">
        <label>Статус:</label>
        <p>
            <span class="status-badge status-<%= task.status %>">
                <%= task.status === 'todo' ? 'К выполнению' : (task.status === 'in_progress' ? 'В работе' : 'Выполнено') %>
            </span>
        </p>
    </div>
    
    <div class="form-group">
        <label>Приоритет:</label>
        <p class="priority-<%= task.priority >= 4 ? 'high' : (task.priority >= 2 ? 'medium' : 'low') %>">
            <%= '!'.repeat(task.priority) %><%= '☆'.repeat(5 - task.priority) %> (<%= task.priority %>/5)
        </p>
    </div>
    
    <div class="form-group">
        <label>Описание:</label>
        <p><%= task.description || 'Нет описания' %></p>
    </div>
    
    <div class="form-group">
        <label>Дата создания:</label>
        <p><%= new Date(task.created_at).toLocaleString('ru-RU') %></p>
    </div>
    
    <a href="/tasks" class="btn">← К списку задач</a>
    <a href="/tasks/new" class="btn btn-success">+ Новая задача</a>
</div>

<%- include('../partials/footer') %>