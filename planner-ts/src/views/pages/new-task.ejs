<%- include('../partials/header') %>

<div style="background: white; padding: 20px; border-radius: 4px; max-width: 600px; margin: 0 auto;">
    <h2>Новая задача</h2>
    
    <form method="POST" action="/tasks">
        <div class="form-group">
            <label>Заголовок *</label>
            <input type="text" name="title" required>
        </div>
        
        <div class="form-group">
            <label>Описание</label>
            <textarea name="description" rows="4"></textarea>
        </div>
        
        <div class="form-group">
            <label>Проект *</label>
            <select name="project_id" required>
                <option value="">Выберите проект</option>
                <% projects.forEach(project => { %>
                    <option value="<%= project.id %>"><%= project.project_name %></option>
                <% }) %>
            </select>
        </div>
        
        <div class="form-group">
            <label>Приоритет (1-5, где 5 - наивысший)</label>
            <input type="number" name="priority" min="1" max="5" value="3" required>
        </div>
        
        <button type="submit">➕ Создать задачу</button>
        <a href="/tasks" class="btn">Отмена</a>
    </form>
</div>

<%- include('../partials/footer') %>