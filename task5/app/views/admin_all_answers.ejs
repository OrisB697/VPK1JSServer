<!DOCTYPE html>
<html>
<head><title>Все ответы</title><link rel="stylesheet" href="/style.css"></head>
<body>
    <header><h1>Все ответы пользователей</h1></header>
    <main style="max-width:1000px; margin:20px auto;">
        <table border="1" cellpadding="8" style="width:100%; border-collapse:collapse;">
            <tr><th>Пользователь</th><th>Вопрос</th><th>Ответ</th><th>Результат</th><th>Время</th></tr>
            <% answers.forEach(a => { %>
                <tr>
                    <td><%= a.login %></td>
                    <td><%= a.question_text %></td>
                    <td><%= a.user_answer %></td>
                    <td ><%= a.is_correct ? '  Правильно' : '  Неправильно' %></td>
                    <td><%= new Date(a.timestamp).toLocaleString() %></td>
                </tr>
            <% }) %>
        </table>
        <br><a href="/">На главную</a>
    </main>
</body>
</html>