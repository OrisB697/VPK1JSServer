<!DOCTYPE html>
<html>
<head><title>Тестирование</title><link rel="stylesheet" href="/style.css"></head>
<body>
    <header><h1>Система тестирования</h1></header>
    <main style="max-width:800px; margin:20px auto;">
        <h3>Добро пожаловать, <%= user.login %>!</h3>
        <form method="POST" action="/submit-test">
            <% questions.forEach((q, idx) => { %>
                <div style="margin-bottom:20px; border-bottom:1px solid #ccc; padding-bottom:10px;">
                    <p><strong><%= idx+1 %>. <%= q.text %></strong></p>
                    <input type="text" name="q_<%= q.id %>" placeholder="Ваш ответ" style="width:100%; padding:8px;" required>
                </div>
            <% }) %>
            <button type="submit">Отправить ответы</button>
        </form>
        <% if (user.is_admin) { %>
            <hr>
            <h4>Админ-панель</h4>
            <a href="/admin/questions">Управление вопросами</a><br>
            <a href="/admin/users-stats">Статистика пользователей</a><br>
            <a href="/admin/all-answers">Все ответы</a>
        <% } %>
        <br><a href="/logout">Выйти</a>
    </main>
    <footer><p>Тестовая система</p></footer>
</body>
</html>