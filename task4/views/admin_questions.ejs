<!DOCTYPE html>
<html>
<head><title>Управление вопросами</title><link rel="stylesheet" href="/style.css"></head>
<body>
    <header><h1>Управление вопросами</h1></header>
    <main style="max-width:800px; margin:20px auto;">
        <h3>Добавить вопрос</h3>
        <form method="POST" action="/admin/questions/add">
            <input type="text" name="text" placeholder="Текст вопроса" style="width:100%; margin-bottom:10px;" required>
            <input type="text" name="correct_answer" placeholder="Правильный ответ" style="width:100%; margin-bottom:10px;" required>
            <button type="submit">Добавить</button>
        </form>
        
        <h3>Существующие вопросы</h3>
        <ul>
            <% questions.forEach(q => { %>
                <li style="margin-bottom:15px;">
                    <strong><%= q.text %></strong> (правильный ответ: <%= q.correct_answer %>)
                    <form method="POST" action="/admin/questions/delete/<%= q.id %>" style="display:inline;">
                        <button type="submit" style="background:red;">Удалить</button>
                    </form>
                </li>
            <% }) %>
        </ul>
        <a href="/">На главную</a>
    </main>
</body>
</html>